# Copy this file to .env and fill in your key.
# Same key as Lab 1 - get a free one (no card required, but requires phone
# verification) at https://build.nvidia.com/settings/api-keys
NVIDIA_API_KEY="nvapi-YOUR_API_KEY"

# "offline" (default) runs with no key and no network, using a hashed
# bag-of-words fallback - good for building and testing your pipeline.
# Switch to "api" once you're ready to use real embeddings.
LAB3_EMBEDDING_MODE="offline"
