# --- AI in Practice environment ---
# Copy to .env and fill in values. Never commit .env.

# LLM access (optional — core path runs offline with zero model calls)
VIDHI_USE_LLM=0
NVIDIA_API_KEY=
NVIDIA_BASE_URL=

# eSankhyiki live API (optional — release-time ingestion only, query path offline)
VIDHI_ESANKHYIKI_URL=https://api.mospi.gov.in

# Offline mode (set to 1 for ConfAI demo — no network, no key)
AIP_OFFLINE=1

# Cost budget (USD) — deterministic path spends $0.00
VIDHI_COST_BUDGET_USD=0.00